packages:
  yum:
    mariadb105-devel: []
    gcc: []
    python3-devel: []
    pkgconfig: []

container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput"
  03_createsu:
    command: "source /var/app/venv/*/bin/activate && python manage.py createsuperuser_if_none_exists"
    leader_only: true
    ignoreErrors: true

option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: propertymanager.wsgi:application
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: static